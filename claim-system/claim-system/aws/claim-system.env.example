# Copy to /etc/claim-system.env on EC2 and run: sudo chmod 600 /etc/claim-system.env
SPRING_PROFILES_ACTIVE=aws
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
DB_URL=jdbc:mysql://YOUR-RDS-ENDPOINT:3306/claimsdb
DB_USER=claimapp
DB_PASSWORD=change-me
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
LOG_DIR=/var/log/claim-system
